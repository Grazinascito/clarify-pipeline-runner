<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.clarify-pipeline-runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{HOME}}/clarify-pipeline-runner/.venv/bin/python</string>
    <string>{{HOME}}/clarify-pipeline-runner/runner.py</string>
  </array>
  <key>WorkingDirectory</key><string>{{HOME}}/clarify-pipeline-runner</string>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>{{HOME}}/clarify-pipeline-runner/logs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/clarify-pipeline-runner/logs/launchd.err.log</string>
</dict>
</plist>
